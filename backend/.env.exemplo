APP_NAME=Laravel
APP_ENV=local
APP_KEY=    # gerado automaticamente por: php artisan key:generate
APP_DEBUG=true
APP_URL=http://localhost:8080

# Database (docker-compose)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=raizes
DB_USERNAME=raizes
DB_PASSWORD=secret
DB_CHARSET=utf8

# Redis (docker-compose)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# JWT
JWT_SECRET=   # gerado automaticamente por: php artisan jwt:secret -f

# Queue / Cache (opcional)
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file